# Local profile: sqlite, clickhouse or auto.
# auto uses ClickHouse when CLICKHOUSE_HOST is filled; connection errors do not fall back.
DATABASE_BACKEND = "sqlite"
SQLITE_DB_PATH = "data/demo_analytics.db"

# Required for custom natural-language queries and model-written summaries.
# Preset analyses, computed summaries, statistical tests and forecasts also work without it.
OPENAI_API_KEY = ""

# Fill these when switching to ClickHouse.
CLICKHOUSE_HOST = ""
CLICKHOUSE_PORT = "8123"
CLICKHOUSE_USERNAME = "default"
CLICKHOUSE_PASSWORD = ""
CLICKHOUSE_DB = "default"
CLICKHOUSE_SECURE = "false"
CLICKHOUSE_VERIFY = "true" # TLS certificate verification; keep enabled unless explicitly configured otherwise
CLICKHOUSE_TABLES = "users,tweet_predictions"

# Application logs never include questions, SQL, filter values or result samples.
LOG_LEVEL = "INFO"
GRAYLOG_ENABLED = "false"
GRAYLOG_HOST = "localhost"
GRAYLOG_PORT = "12201"
GRAYLOG_PROTOCOL = "udp" # udp or tcp
